# === サイトURL（本番ドメインが決まったら設定）=== 要確認
NEXT_PUBLIC_SITE_URL=https://456chinnendo.jp

# === お問い合わせフォームのメール送信設定 ===
# RESEND_API_KEY が未設定の場合、フォームは「準備中」メッセージを表示し、
# 電話・Instagram誘導に切り替わります。
# Resend（https://resend.com）を利用する場合の例：
RESEND_API_KEY=
# 問い合わせの送信先メールアドレス（受信箱）
CONTACT_TO_EMAIL=chinnen.456@au.com
# 送信元アドレス（Resendで認証済みドメインのアドレス）
CONTACT_FROM_EMAIL=onboarding@resend.dev
