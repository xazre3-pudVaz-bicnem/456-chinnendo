# === サイトURL ===
NEXT_PUBLIC_SITE_URL=https://www.456chinnendo.com

# === お問い合わせフォーム ===
# フォームは mailto 方式（訪問者のメールソフトを起動）のため、
# サーバー側の設定は不要です。宛先の変更は src/data/site.ts の email を編集。

# === アクセス解析・Search Console（任意。設定すると有効になる） ===
# GA4 の測定ID（例: G-XXXXXXXXXX）。未設定なら計測タグは出力されません。
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console のHTMLタグ認証コード（content="..." の値のみ）
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
